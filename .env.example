# Application Environment
ENVIRONMENT=development
PORT=8000
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codefort

# Security & Sessions
SESSION_SECRET=change-this-in-production-to-a-32-byte-hex
EXTENSION_TOKEN_SIGNING_KEY=change-this-in-production-to-a-32-byte-hex
ALLOWED_WEB_ORIGINS=http://localhost:3000,chrome-extension://*

# GitHub Integration
GITHUB_CLIENT_ID=placeholder_client_id
GITHUB_CLIENT_SECRET=placeholder_client_secret
GITHUB_APP_ID=placeholder_app_id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=placeholder_webhook_secret

# AI & LLM (BARQAI Engine)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.8-max-0902
OPENROUTER_REASONING=xhigh
LLM_API_KEY=placeholder_llm_api_key

# Queue & Cache
REDIS_URL=redis://localhost:6379/0
